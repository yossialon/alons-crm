# =============================================================================
# Alon's Kitchens CRM — Environment Variables Reference
# =============================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git — add it to .gitignore if not already there.
#
# Quick generators:
#   Random secret:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   Password hash:  node -e "require('bcryptjs').hash('YOUR_PASSWORD',12).then(console.log)"
# =============================================================================

# ── App ────────────────────────────────────────────────────────────────────────
# Deployed URL (no trailing slash). Used for OAuth redirects and internal API calls.
# Dev: http://localhost:3000   Prod: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# UUID for the single-tenant org row. Matches default seed row.
ORG_ID=00000000-0000-0000-0000-000000000001

# ── Supabase ───────────────────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # SERVER-ONLY — never expose to the browser

# ── Auth ───────────────────────────────────────────────────────────────────────
# JWT signing secret. Must be ≥32 chars (generate 64+ hex chars recommended).
SESSION_SECRET=replace-with-128-char-hex-string

# CRM admin login credentials (single-user mode)
CRM_USERNAME=admin
CRM_PASSWORD_HASH=$2a$12$REPLACE_WITH_YOUR_BCRYPT_HASH_HERE

# ── Anthropic / Claude API ─────────────────────────────────────────────────────
# https://console.anthropic.com/ → API Keys
# Both names work — ANTHROPIC_API_KEY is the standard, CLAUDE_API_KEY is legacy.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# CLAUDE_API_KEY=sk-ant-your-key-here   # uncomment if you prefer the legacy name

# Max AI requests per IP per hour via the /api/claude proxy (default: 100)
# CLAUDE_RATE_LIMIT_MAX=100

# ── Stripe Billing ─────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Dashboard → Products → your price IDs
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_...
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_...

# ── Meta / Facebook ────────────────────────────────────────────────────────────
# https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=
# Verify token — any random string; set the same value in Meta webhook dashboard
META_WEBHOOK_VERIFY_TOKEN=choose-a-random-secret-string
# Facebook Page access token (Graph API → your page → generate token)
META_PAGE_ACCESS_TOKEN=

# ── WhatsApp Cloud API ─────────────────────────────────────────────────────────
# Meta Business Manager → WhatsApp → API Setup
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# ── Meta Ads ───────────────────────────────────────────────────────────────────
# System user token — needs ads_management + ads_read + pages_read_engagement
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_PAGE_ID=
# Optional — enables pixel-based optimization in ad campaigns
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=                      # same value — server-side alias
META_RETARGETING_AUDIENCE_ID=       # optional — pre-created 30-day website visitor audience

# ── Instagram Graph API ────────────────────────────────────────────────────────
# Meta Business Manager → Instagram → API Setup
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Feature flag — set to 'false' to disable auto-reply on comments
INSTAGRAM_AUTO_REPLY=true

# ── Google ─────────────────────────────────────────────────────────────────────
# Google Cloud Console → Enable "Places API (New)" → Create API key
GOOGLE_PLACES_API_KEY=

# Google Business Profile OAuth (for posting local posts and replying to reviews)
# https://console.cloud.google.com → OAuth 2.0 → Web application
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=

# Google review link (Business Profile → Get more reviews → short URL)
GOOGLE_REVIEW_LINK=https://g.page/r/YOUR_REVIEW_LINK/review

# ── Owner / Notifications ──────────────────────────────────────────────────────
# WhatsApp number in E.164 format: +19541234567
OWNER_PHONE=+1954859XXXX
# Owner first name for personalized Hebrew WhatsApp messages
OWNER_NAME=אלון

# ── Agent Security ─────────────────────────────────────────────────────────────
# Bearer token for /api/agents/* and /api/cron/* routes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SECRET=replace-with-64-char-hex-string
CRON_SECRET=replace-with-64-char-hex-string   # can match AGENT_SECRET

# ── Lead Hunter Tuning ─────────────────────────────────────────────────────────
# Minimum AI score (0–100) for a lead to be auto-imported (default: 70)
LEAD_MIN_SCORE=70
# Response time threshold (ms) — Tech Manager alerts owner above this (default: 3000)
TECH_ALERT_THRESHOLD_MS=3000

# ── Hunter.io ─────────────────────────────────────────────────────────────────
# Email enrichment — https://hunter.io/api (free tier: 25 searches/month)
HUNTER_API_KEY=

# ── Redis (optional — strongly recommended for production) ─────────────────────
# Enables persistent, cross-process rate limiting.
# Without Redis, rate limits reset on every cold start (in-memory only).
#
# Option A — Upstash REST (recommended for Vercel serverless):
#   https://console.upstash.com → Redis → REST API
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=AX...
#
# Option B — Self-hosted Redis TCP (ioredis):
# REDIS_URL=redis://localhost:6379

# ── Creative Studio ────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=Alon's Kitchens
NEXT_PUBLIC_BRAND_TAGLINE=Custom Cabinets & Vanities · South Florida

# ── Feature Flags ──────────────────────────────────────────────────────────────
# Auto-send outreach message when a lead is imported
NEXT_PUBLIC_AUTO_OUTREACH_ON_IMPORT=true
# WhatsApp auto-reply for inbound messages
WHATSAPP_AUTO_REPLY=true

# ── Sentry Error Tracking ──────────────────────────────────────────────────────
# https://sentry.io → Project Settings → Client Keys → DSN
SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
# https://sentry.io/settings/auth-tokens/ (needs project:releases + org:read)
SENTRY_AUTH_TOKEN=sntrys_your_token_here

# ── Dev Only ───────────────────────────────────────────────────────────────────
# Bypasses JWT auth in local development ONLY. Has NO effect in production.
# DISABLE_AUTH=true
