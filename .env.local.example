# ── Anthropic ──────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Login credentials ──────────────────────────────────────
# Username for the single admin account
CRM_USERNAME=admin

# Bcrypt hash of the admin password (cost factor 12 recommended).
# Generate with: node -e "require('bcryptjs').hash('YOUR_PASSWORD',12).then(console.log)"
CRM_PASSWORD_HASH=$2a$12$REPLACE_WITH_YOUR_BCRYPT_HASH_HERE

# ── Session secret ─────────────────────────────────────────
# Must be at least 32 characters (64+ hex chars recommended).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-with-128-hex-char-random-string

# ── Database ───────────────────────────────────────────────
# Supabase:  postgresql://postgres.[ref]:[password]@aws-0-*.pooler.supabase.com:6543/postgres
# Neon:      postgresql://user:pass@ep-*.neon.tech/neondb?sslmode=require
# Local:     postgresql://postgres:postgres@localhost:5432/crm
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm

# UUID of the default org (matches the seed row in scripts/schema.sql)
ORG_ID=00000000-0000-0000-0000-000000000001

# ── Redis (optional) ───────────────────────────────────────
# Enables persistent, cross-process rate limiting.
# Falls back to in-memory if not set (fine for single-server deploys).
# REDIS_URL=redis://localhost:6379

# ── Sentry ─────────────────────────────────────────────────
# Get your DSN at https://sentry.io → Project Settings → Client Keys
# Server-side (never public)
SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX
# Client-side (safe to expose to the browser)
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX

# Sentry build vars — needed for source map upload during `next build`
# These can also go in .env.sentry-build-plugin (gitignored)
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
# Create at https://sentry.io/settings/auth-tokens/ (needs project:releases + org:read)
SENTRY_AUTH_TOKEN=sntrys_your_token_here

# ── Google Places API ──────────────────────────────────────
# https://console.cloud.google.com → Enable "Places API" → Create API key
GOOGLE_PLACES_API_KEY=

# ── Hunter.io ──────────────────────────────────────────────
# https://hunter.io/api → free tier = 25 searches/month
HUNTER_API_KEY=

# ── Auto-outreach ──────────────────────────────────────────
# Set to 'false' to disable auto-outreach when a lead is imported
NEXT_PUBLIC_AUTO_OUTREACH_ON_IMPORT=true

# ── Job Completion / Marketing ──────────────────────────────
# Google Business Profile API (get from Google Cloud Console → OAuth 2.0)
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=

# Instagram Business Graph API (Meta Developer Console)
# Image must be a public URL — use Supabase Storage
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Google Review link (Google Business Profile → Get more reviews)
GOOGLE_REVIEW_LINK=https://g.page/r/YOUR_REVIEW_LINK/review

# Supabase service role key (for storage uploads — get from Supabase dashboard → Settings → API)
SUPABASE_SERVICE_ROLE_KEY=

# ── Meta / Facebook / Instagram / WhatsApp ─────────────────────────────────
# Meta Developer Console: https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=

# Webhook verify token — pick any random string and set the same in Meta dashboard
META_WEBHOOK_VERIFY_TOKEN=alons_verify_token

# Facebook Page access token (Graph API → your page → generate token)
META_PAGE_ACCESS_TOKEN=

# WhatsApp Business API (Meta Business Suite → WhatsApp → API setup)
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=

# Instagram Business account (same Meta app, Instagram Basic Display or Messaging)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Feature flags
INSTAGRAM_AUTO_REPLY=true
WHATSAPP_AUTO_REPLY=true
