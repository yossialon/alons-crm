# ── Anthropic ──────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Login credentials ──────────────────────────────────────
# Username for the single admin account
CRM_USERNAME=admin

# Bcrypt hash of the admin password (cost factor 12 recommended).
# Generate with: node -e "require('bcryptjs').hash('YOUR_PASSWORD',12).then(console.log)"
CRM_PASSWORD_HASH=$2a$12$REPLACE_WITH_YOUR_BCRYPT_HASH_HERE

# ── Session secret ─────────────────────────────────────────
# Must be at least 32 characters (64+ hex chars recommended).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-with-128-hex-char-random-string

# ── Database ───────────────────────────────────────────────
# Supabase:  postgresql://postgres.[ref]:[password]@aws-0-*.pooler.supabase.com:6543/postgres
# Neon:      postgresql://user:pass@ep-*.neon.tech/neondb?sslmode=require
# Local:     postgresql://postgres:postgres@localhost:5432/crm
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm

# UUID of the default org (matches the seed row in scripts/schema.sql)
ORG_ID=00000000-0000-0000-0000-000000000001

# ── Redis (optional) ───────────────────────────────────────
# Enables persistent, cross-process rate limiting.
# Falls back to in-memory if not set (fine for single-server deploys).
# REDIS_URL=redis://localhost:6379

# ── Sentry ─────────────────────────────────────────────────
# Get your DSN at https://sentry.io → Project Settings → Client Keys
# Server-side (never public)
SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX
# Client-side (safe to expose to the browser)
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX

# Sentry build vars — needed for source map upload during `next build`
# These can also go in .env.sentry-build-plugin (gitignored)
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
# Create at https://sentry.io/settings/auth-tokens/ (needs project:releases + org:read)
SENTRY_AUTH_TOKEN=sntrys_your_token_here
